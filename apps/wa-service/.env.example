# WhatsApp servisi ortam degiskenleri.
# Bu dosyayi kopyalayip .env yapin:  copy .env.example .env
#
# Supabase -> Project Settings -> Database -> Connect -> Session pooler
# Kullanici: postgres.<proje-ref>   Port: 5432 (6543 degil)

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Kira / worker kimligi. Ayni anda tek process bu id ile calismali.
WORKER_ID=oracle-1

# Saglik ucu
PORT=8080

# Oturum kapasitesi (Always Free 24GB icin 50 rahat)
MAX_SESSIONS=50

# Tek mesaj zaman asimi (ms). Gorsel gonderimde 60s bazen kisa kalir.
SEND_TIMEOUT_MS=90000

# WhatsApp servisi ortam degiskenleri.
# Bu dosyayi kopyalayip .env yapin:  copy .env.example .env
#
# Supabase -> Project Settings -> Database -> Connect -> Session pooler
# Kullanici: postgres.<proje-ref>   Port: 5432 (6543 degil)

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ZORUNLU. Kira / worker kimligi. Ayni anda tek process bu id ile calismali.
WORKER_ID=oracle-1

# Saglik ucu
PORT=8080

# Oturum kapasitesi (Always Free 24GB icin 50 rahat)
MAX_SESSIONS=50

# Tek mesaj zaman asimi (ms). Gorsel gonderimde 60s bazen kisa kalir.
SEND_TIMEOUT_MS=90000

# Stuck claimed/running job reclaim (saniye). Scrape/discover icin 900 onerilir.
STALE_JOB_SECONDS=900

# Google Places API (New) — yerel isletme kesfi (contacts.discover)
# GOOGLE_MAPS_API_KEY=
# DISCOVER_ENGINE=auto
# Tek arama = 1 API istegi, max 20 sonuc. Kota kilidi: docs/places-kota.md
# DISCOVER_MAX_RESULTS=20

# Graceful shutdown drain (ms)
SHUTDOWN_DRAIN_MS=20000

LEASE_TTL_SECONDS=60
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=10
CAMPAIGN_TICK_MS=5000
DB_POOL_MAX=10
LOG_LEVEL=info
NODE_ENV=production

{
  "name": "@wa/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/check-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "health": "node -e \"fetch('http://127.0.0.1:'+(process.env.HEALTH_PORT||8080)+'/ready').then(async r=>{const j=await r.json();console.log(r.status,JSON.stringify(j));process.exit(j.ready?0:1)}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "@wa/shared": "*",
    "@whiskeysockets/baileys": "6.7.24",
    "cheerio": "^1.1.2",
    "node-cache": "5.1.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "playwright": "^1.49.1",
    "sharp": "^0.34.2",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "typescript": "^5"
  }
}

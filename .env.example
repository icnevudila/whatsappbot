# Bu dosyayi kopyalayip doldurun. .env asla commit edilmez (.gitignore'da).
#
#   apps/panel/.env.local       -> panel degiskenleri
#   apps/wa-service/.env        -> servis degiskenleri
#
# ---------------------------------------------------------------------------
# Panel (Next.js, Vercel)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ ile baslayan her degisken tarayiciya gider.
# Buraya ASLA secret / service_role anahtari konmaz.
NEXT_PUBLIC_SUPABASE_URL=https://rnkrjmblgcdqlyslbhob.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_S2-QnqQVsshYjQ7PR5lOxg_pYeS9gzB

# Panel public URL (Stripe redirect + davet linkleri). Ornek: https://panel.filo.app
# NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-DOMAIN

# ---------------------------------------------------------------------------
# Satisa hazirlik — Vercel Production env (secret; asla NEXT_PUBLIC_ degil)
# ---------------------------------------------------------------------------
# Supabase Dashboard → Settings → API → service_role (davet + Stripe webhook)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe Dashboard → Developers → API keys (test: sk_test_… / canli: sk_live_…)
# STRIPE_SECRET_KEY=

# Stripe → Products → abonelik Price ID (price_…)
# STRIPE_PRICE_ID=

# Stripe → Developers → Webhooks → endpoint
#   URL: https://YOUR-DOMAIN/api/billing/webhook
#   Events: checkout.session.completed, customer.subscription.updated
# STRIPE_WEBHOOK_SECRET=whsec_…

# ---------------------------------------------------------------------------
# Yapay zeka saglayicilari (panel, hepsi istege bagli)
# ---------------------------------------------------------------------------
# HICBIRI ZORUNLU DEGIL. Anahtar girilmezse gorsel uretimi anahtarsiz calisan
# Pollinations'a duser; metin uretimi ise kapali kalir ve arayuz bunu soyler.
# Anahtar eklendiginde kod degisikligi gerekmez, zincir kendiliginden devreye
# girer. Bu degiskenler yalnizca sunucuda okunur, tarayiciya gitmez.

# Google Gemini -- aistudio.google.com/apikey. Ucretsiz katmani var.
# Gorsel + metin uretebiliyor.
GEMINI_API_KEY=

# Google Places API (New) -- yerel isletme kesfi (wa-service).
# console.cloud.google.com → Places API (New) + API key. Aylik ucretsiz SKU kotasi var.
# GOOGLE_MAPS_API_KEY=
# DISCOVER_ENGINE=auto
# Model kimlikleri sik degisiyor ve eskiler kapatiliyor; varsayilanlar guncel
# onerilen surumler, sorun cikarsa buradan geri alabilirsiniz.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI (ChatGPT) -- platform.openai.com/api-keys. Ucretsiz katmani yok,
# kullandigin kadar odeme.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_TEXT_MODEL=gpt-4o-mini
# Uyumlu bir ara sunucu (OpenRouter, Azure vb.) kullaniyorsan:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudflare Workers AI (FLUX schnell) -- gunluk ucretsiz kotasi var.
# Yalnizca gorsel. dash.cloudflare.com -> AI -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deneme sirasi. Ilk basarili olan kazanir, yapilandirilmamis olan atlanir.
# AI_IMAGE_PROVIDERS=gemini,openai,cloudflare,pollinations
# AI_TEXT_PROVIDERS=gemini,openai
# AI_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# WhatsApp servisi (VPS, Docker)
# ---------------------------------------------------------------------------
# Servis Data API yerine dogrudan Postgres'e baglanir: wa semasi bilincli
# olarak Data API'ye kapali ve is kuyrugu gercek bir transaction icinde
# FOR UPDATE SKIP LOCKED ile calisir.
#
# Supabase panelinde: Connect -> ORMs / Direct connection.
# Sifreyi ve host'u oradan alin. [YOUR-PASSWORD] kismini doldurun.
DATABASE_URL=postgresql://postgres.rnkrjmblgcdqlyslbhob:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Kira sahibinin kimligi. Her process icin FARKLI olmak zorunda; ayni kimlikle
# iki process acilirsa ayni hesabi ikisi de sahiplenir ve 440 dongusu baslar.
# Bos birakilirsa acilista rastgele uretilir.
WORKER_ID=vps-1

# Tek process'te acilacak azami oturum.
# Olcek referansi: 50 oturum ~4 GB, oturum basina ~60 MB.
MAX_SESSIONS=50

# Oturum kirasi (saniye). Yenileme bunun ucte biri sikliginda yapilir.
LEASE_TTL_SECONDS=60

# Komut kuyrugu
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=10

# Kampanya motoru tick araligi
CAMPAIGN_TICK_MS=5000

# Baileys icinde bazi operasyonlar zaman asimsiz tek bir mutex uzerinde
# serilesiyor; park etmis bir gonderim o hesaptaki her seyi susturabiliyor.
SEND_TIMEOUT_MS=60000

DB_POOL_MAX=10
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
